# /etc/ozon-seller-mcp.env — права 600, владелец root.
# Заполнить и НЕ коммитить.

OZON_CLIENT_ID=
OZON_API_KEY=

# --- OAuth (основной способ доступа) ---
# Внешний адрес сервера. Его наличие включает OAuth.
OZON_PUBLIC_URL=ozon-mcp.example.com

# Хеш пароля владельца: ozon-seller-mcp --hash-password
# Сам пароль нигде не хранится — вы вводите его на экране согласия
# при подключении каждого нового устройства.
OZON_OWNER_PASSWORD_HASH=

# Клиенты и токены. Переживает перезапуск: без этого каждый рестарт
# отключал бы все устройства.
OZON_OAUTH_STORE=/var/lib/ozon-seller-mcp/oauth.json

# --- Статические токены (только для автоматизации) ---
# Не истекают и не отзываются поштучно. Людям и клиентам Claude
# нужен OAuth, а не это. Оставьте пустыми, если автоматизации нет.
OZON_TOKEN_READ=
OZON_TOKEN_WRITE=

# --- Пороги защиты ---
OZON_MAX_PRICE_DELTA=30
OZON_MAX_ITEMS_PER_WRITE=100
OZON_MAX_RESPONSE_BYTES=120000

# --- Сеть ---
# Если Ozon недоступен из-под VPN, см. docs/NETWORK.md
# OZON_PROXY=socks5://127.0.0.1:1080
