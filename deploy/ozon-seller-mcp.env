# /etc/ozon-seller-mcp.env — права 600, владелец root.
# Заполнить и НЕ коммитить.

OZON_CLIENT_ID=
OZON_API_KEY=

# Токены доступа. Сгенерировать: ozon-seller-mcp --gen-token
# Делайте их РАЗНЫМИ: устройство с читающим токеном не сможет
# изменить магазин, даже если попросить очень настойчиво.
OZON_TOKEN_READ=
# Пишущий токен можно вообще не задавать — тогда через сеть
# магазин изменить нельзя ничем.
OZON_TOKEN_WRITE=

# Пороги защиты
OZON_MAX_PRICE_DELTA=30
OZON_MAX_ITEMS_PER_WRITE=100
OZON_MAX_RESPONSE_BYTES=120000
