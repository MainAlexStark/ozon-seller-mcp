# Caddy сам выпускает и продлевает сертификат Let's Encrypt.
#
# Один файл на оба способа развёртывания:
#
#   docker compose — домен и адрес сервера приходят переменными,
#                    файл монтируется в контейнер как есть;
#   вручную        — значения по умолчанию, домен правится здесь:
#
#                      sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#                      sudo systemctl reload caddy

{$OZON_DOMAIN:ozon-mcp.example.com} {
	# С переходом на OAuth секретов в адресе больше нет, поэтому пути
	# логируются как обычно. Строку запроса всё же вычищаем: туда может
	# попасть код авторизации, если клиент ошибётся с методом.

	reverse_proxy {$OZON_UPSTREAM:127.0.0.1:8571} {
		# ozon_import_status с wait=true ждёт до 5 минут.
		transport http {
			response_header_timeout 6m
		}
	}
}
