# deploy/ozon-seller-mcp.env — права 600. Заполнить и НЕ коммитить.
# deploy.sh заполняет всё сам при первом развёртывании.

# Внешний адрес сервиса. На нём живут регистрация, кабинет, OAuth и /mcp.
OZON_PUBLIC_URL=https://ozon-mcp.example.com

# База. Пароль придумывает deploy.sh и кладёт его же в deploy/postgres.env.
OZON_DATABASE_URL=postgres://ozon:ПАРОЛЬ@postgres:5432/ozon?sslmode=disable

# Мастер-ключ, которым шифруются API-ключи магазинов в базе.
# Сгенерировать: ozon-seller-mcp --gen-secret
# ПОТЕРЯ КЛЮЧА = все пользователи подключают магазины заново.
# Храните копию отдельно от резервных копий базы: вместе они
# раскрывают ключи всех магазинов.
OZON_SECRET_KEY=

# Регистрация: open — любой может завести учётную запись, closed — нет
# (существующие пользователи продолжают работать).
OZON_SIGNUP=open

# --- Пороги защиты ---
OZON_MAX_PRICE_DELTA=30
OZON_MAX_ITEMS_PER_WRITE=100
OZON_MAX_RESPONSE_BYTES=120000

# --- Сеть ---
# Если Ozon недоступен с этого сервера, см. docs/NETWORK.md
# OZON_PROXY=socks5://127.0.0.1:1080
